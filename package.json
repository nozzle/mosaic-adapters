{
  "name": "nozzle-mosaic-adapters-monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/nozzle/mosaic-adapters.git"
  },
  "type": "module",
  "scripts": {
    "clear-build": "nx run-many --target=clear-build --exclude=examples/**",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version",
    "actions:pin-check": "node ./tools/check-github-action-pins.mjs",
    "test:ci": "pnpm run test:format && pnpm run test:manifests && pnpm run actions:pin-check && pnpm run test:types:all && pnpm run test:lint:all && pnpm run test:lib:all && pnpm run build:all",
    "test:format": "oxfmt --check",
    "test:manifests": "node ./tools/check-internal-peer-ranges.mjs",
    "test:types": "nx run-many --target=test:types",
    "test:types:all": "nx run-many --target=test:types --all",
    "test:lint": "nx affected --target=test:lint",
    "test:lint:all": "nx run-many --target=test:lint --all",
    "test:lib": "nx affected --target=test:lib",
    "test:lib:all": "nx run-many --target=test:lib --all",
    "test:e2e": "pnpm run playwright:install && nx affected --target=test:e2e",
    "test:e2e:all": "pnpm run playwright:install && nx run-many --target=test:e2e --all",
    "playwright:install": "playwright install --with-deps chromium",
    "test:pr": "nx affected --targets=test:lint,test:types,test:lib,build,test:e2e",
    "build": "pnpm run build:packages",
    "build:packages": "nx affected --target=build --exclude=examples/**",
    "build:all": "nx run-many --target=build --all",
    "watch": "pnpm run build:packages && nx watch --all -- pnpm run build:packages",
    "format": "oxfmt",
    "dev": "pnpm run watch"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "catalog:",
    "@uwdata/mosaic-core": "catalog:",
    "@uwdata/mosaic-sql": "catalog:",
    "@uwdata/vgplot": "catalog:",
    "jsdom": "catalog:",
    "nx": "^23.2.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.2.2"
}
