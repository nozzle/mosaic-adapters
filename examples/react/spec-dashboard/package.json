{
  "name": "example-react-spec-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "clear-build": "rimraf dist",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ./src ./tests",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "test:lint": "pnpm run lint",
    "test:lib": "vitest tests/*.unit.test.ts",
    "test:e2e": "playwright test",
    "test:types": "pnpm run typecheck"
  },
  "dependencies": {
    "@nozzleio/mosaic-tanstack-react-table": "^0.14.1",
    "@nozzleio/react-mosaic": "^0.11.1",
    "@tanstack/react-table": "catalog:",
    "@uwdata/mosaic-core": "catalog:",
    "@uwdata/mosaic-sql": "catalog:",
    "@uwdata/vgplot": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nozzleio/test-support": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "test:lib": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
